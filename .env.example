# ==============================================================================
# Moda In Europe - Environment Variables Configuration
# Copy this file to .env or .env.local for local testing.
# In Vercel, configure these variables in: Project Settings -> Environment Variables.
#
# NOTE: All variables prefixed with VITE_ are exposed to the client bundle.
# NEVER put private server-side secrets or master database passwords in VITE_ variables.
# ==============================================================================

# Application Production Base URL (used for canonical links, sitemaps, Open Graph)
VITE_APP_URL=https://your-production-app.vercel.app

# Public Site Name
VITE_SITE_NAME="Moda In Europe"

# Voice & AI Engine Configuration
# (Leave blank to use the built-in 100% free client-side Web Audio + Web Speech pipeline)
VITE_VAPI_API_KEY=your_vapi_public_key_here
VITE_VAPI_ASSISTANT_ID=your_vapi_assistant_id_here

# E-commerce Store Integration (Optional - uses built-in verified catalog by default)
VITE_WOOCOMMERCE_API_URL=https://modaineurope.com/wp-json/wc/v3
